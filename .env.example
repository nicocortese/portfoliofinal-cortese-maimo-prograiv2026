# Copiá este archivo como .env y completá los valores.
# En Vercel: Settings → Environment Variables.

# Clima en vivo (OpenWeather). Se usa en el navegador: sirve con o sin PUBLIC_.
OPENWEATHER_API_KEY=

# Opcional: evita el límite de la API de GitHub al hacer el build y permite
# contar también los repositorios privados.
GITHUB_TOKEN=
