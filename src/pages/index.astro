---
import Layout from "../layouts/Layout.astro";
import LibroInteractivo, { type RepoData } from "../components/libro/LibroInteractivo.tsx";
import { FRONTEND_PROJECTS, GITHUB_USER } from "../data/projectsData";

/*
 * Repositorios desde la API de GitHub (se piden al generar el sitio).
 * El campo "homepage" de cada repo es el link de Vercel que muestra el álbum.
 * El clima, en cambio, se pide en vivo desde el navegador (ClimaWidget).
 */
async function fetchRepos(): Promise<RepoData[]> {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const respuesta = await fetch(
      `https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100`,
      {
        headers: {
          Accept: "application/vnd.github+json",
          "User-Agent": "portfolio-album-2026",
          ...(token ? { Authorization: `Bearer ${token}` } : {}),
        },
      },
    );
    if (!respuesta.ok) return [];

    const data = (await respuesta.json()) as RepoData[];
    const nombres = FRONTEND_PROJECTS.map((proyecto) => proyecto.repo);

    return data
      .filter((repo) => nombres.includes(repo.name))
      .map((repo) => ({
        name: repo.name,
        description: repo.description,
        html_url: repo.html_url,
        homepage: repo.homepage,
        language: repo.language,
        stargazers_count: repo.stargazers_count,
        pushed_at: repo.pushed_at,
      }));
  } catch {
    return [];
  }
}

const repos = await fetchRepos();
---

<Layout title="Álbum 2026 | Nicolás Cortese">
  <main class="h-screen w-screen overflow-hidden bg-night">
    <LibroInteractivo client:only="react" repos={repos} />
  </main>
</Layout>
