import Layout from "../layouts/Layout.astro";
import LibroInteractivo from "../components/libro/LibroInteractivo.tsx";

// --- FIGURITA DINÁMICA: CLIMA DE BUENOS AIRES (server-side) ---
const WEATHER_API_KEY = import.meta.env.OPENWEATHER_API_KEY;
const WEATHER_ENDPOINT = `https://api.openweathermap.org/data/2.5/weather?q=${encodeURIComponent(
  "Buenos Aires,AR",
)}&units=metric&lang=es&appid=${WEATHER_API_KEY}`;

interface OpenWeatherResponse {
  weather: { id: number; main: string; description: string }[];
  main: { temp: number };
}

interface EstadoNico {
  temp: number;
  icono: string;
  condicion: "sol" | "lluvia" | "nubes" | "frio";
  cielo: string;
  estado: string;
  modo: "Estudio" | "Outdoor" | "Híbrido";
  error: boolean;
}

async function fetchClima(): Promise<EstadoNico> {
  try {
    const response = await fetch(WEATHER_ENDPOINT);

    if (!response.ok) {
      throw new Error(`OpenWeather respondió con estado ${response.status}`);
    }

    const data = (await response.json()) as OpenWeatherResponse;
    const temp = Math.round(data.main.temp);
    const weather = data.weather?.[0];
    const cieloRaw = weather?.description ?? "sin datos";
    const cielo = cieloRaw.charAt(0).toUpperCase() + cieloRaw.slice(1);

    const llueve = weather ? weather.id >= 200 && weather.id < 600 : false;

    let icono: string;
    let condicion: EstadoNico["condicion"];
    let estado: string;
    let modo: EstadoNico["modo"];

    if (llueve || temp < 18) {
      icono = llueve ? "🌧️" : "🥶";
      condicion = llueve ? "lluvia" : "frio";
      estado =
        "El clima pide termo de mate, maquetar componentes y tirar renders en After Effects.";
      modo = "Estudio";
    } else if (temp >= 24) {
      icono = "☀️";
      condicion = "sol";
      estado = "Es una tarde perfecta para un fulbito y salir a sacar fotos.";
      modo = "Outdoor";
    } else {
      icono = "🌤️";
      condicion = "nubes";
      estado =
        "Un buen equilibrio entre avanzar con código frontend y relajar un rato.";
      modo = "Híbrido";
    }

    return { temp, icono, condicion, cielo, estado, modo, error: false };
  } catch (e) {
    console.error("No se pudo obtener el clima de Buenos Aires:", e);

    return {
      temp: 20,
      icono: "🌤️",
      condicion: "nubes",
      cielo: "No disponible",
      estado:
        "No pude consultar el clima, pero el plan sigue: código frontend y un mate.",
      modo: "Híbrido",
      error: true,
    };
  }
}

const clima = await fetchClima();

// --- FIGURITAS DE GITHUB (server-side, para la página 14) ---
const GITHUB_USERNAME = import.meta.env.GITHUB_USERNAME ?? "nicocortese";
const REPOS_ENDPOINT = `https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=30`;

const FEATURED_REPOS = [
  "fixea-web",
  "retro-kicks-frontend",
  "maimo-progra3-2025-tpfinalfrontend-cortese",
  "maimo-progra3-2025-tp2-cortese",
];

interface GithubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  pushed_at: string;
}

async function fetchRepos(): Promise<GithubRepo[]> {
  try {
    const response = await fetch(REPOS_ENDPOINT, {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": `${GITHUB_USERNAME}-portfolio`,
        ...(import.meta.env.GITHUB_TOKEN
          ? { Authorization: `Bearer ${import.meta.env.GITHUB_TOKEN}` }
          : {}),
      },
    });

    if (!response.ok) return [];

    const data = (await response.json()) as GithubRepo[];

    return data
      .filter((repo) => FEATURED_REPOS.includes(repo.name))
      .sort(
        (a, b) => FEATURED_REPOS.indexOf(a.name) - FEATURED_REPOS.indexOf(b.name),
      );
  } catch {
    return [];
  }
}

const repos = await fetchRepos();
