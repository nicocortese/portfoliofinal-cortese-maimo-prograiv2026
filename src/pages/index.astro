---
import Layout from "../layouts/Layout.astro";
import LibroInteractivo, { type GithubResumen, type RepoData } from "../components/libro/LibroInteractivo.tsx";
import { FRONTEND_PROJECTS, GITHUB_USER } from "../data/projectsData";

/*
 * Datos de la API de GitHub (se piden al generar el sitio).
 * - repos: los de los proyectos frontend. Su "homepage" es el link de Vercel.
 * - resumen: métricas sobre todos los repos del usuario para el recuadro azul.
 * Con GITHUB_TOKEN se consulta /user/repos, que incluye repos privados;
 * sin token se usa el endpoint público como fallback.
 * El clima, en cambio, se pide en vivo desde el navegador (ClimaWidget).
 */
async function fetchGithub(): Promise<{ repos: RepoData[]; resumen: GithubResumen | null }> {
  try {
    const token = import.meta.env.GITHUB_TOKEN;
    const cabeceras = {
      Accept: "application/vnd.github+json",
      "User-Agent": "portfolio-album-2026",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    };

    const urlConToken =
      "https://api.github.com/user/repos?per_page=100&sort=pushed&direction=desc&affiliation=owner";
    const urlPublica = `https://api.github.com/users/${GITHUB_USER}/repos?sort=pushed&direction=desc&per_page=100&type=owner`;

    const pedir = async (url: string) => {
      const respuesta = await fetch(url, { headers: cabeceras });
      if (!respuesta.ok) return null;
      return (await respuesta.json()) as (RepoData & { fork: boolean; private: boolean })[];
    };

    let todos = token ? await pedir(urlConToken) : null;
    if (!todos) todos = await pedir(urlPublica);
    if (!todos) return { repos: [], resumen: null };


    const propios = todos.filter((repo) => !repo.fork);
    const nombres = FRONTEND_PROJECTS.map((proyecto) => proyecto.repo);

    const conteo: Record<string, number> = {};
    for (const repo of propios) {
      if (repo.language) conteo[repo.language] = (conteo[repo.language] ?? 0) + 1;
    }
    const lenguajes = Object.entries(conteo)
      .sort((a, b) => b[1] - a[1])
      .map(([lenguaje]) => lenguaje);

    return {
      repos: propios
        .filter((repo) => nombres.includes(repo.name))
        .map((repo) => ({
          name: repo.name,
          description: repo.description,
          html_url: repo.html_url,
          homepage: repo.homepage,
          language: repo.language,
          pushed_at: repo.pushed_at,
        })),
      resumen: {
        totalRepos: todos.length,
        conDeploy: todos.filter((repo) => repo.homepage).length,
        ultimoPush: todos[0]?.pushed_at ?? "",
        lenguajes,
      },
    };
  } catch {
    return { repos: [], resumen: null };
  }
}

const { repos, resumen } = await fetchGithub();
---

<Layout title="Álbum 2026 | Nicolás Cortese">
  <main class="h-screen w-screen overflow-hidden bg-night">
    <LibroInteractivo client:only="react" repos={repos} github={resumen} />
  </main>
</Layout>
